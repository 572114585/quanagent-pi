{
	"name": "@earendil-works/pi-weixin-bridge",
	"version": "1.3.0",
	"private": true,
	"description": "Weixin bridge for Pi with per-user sessions, media and scheduled delivery",
	"type": "module",
	"license": "ISC",
	"scripts": {
		"clean": "shx rm -rf dist",
		"start": "node --import ../coding-agent/src/experimental/source-resolver.ts src/daemon.ts",
		"login": "node --import ../coding-agent/src/experimental/source-resolver.ts src/demo/login.ts",
		"test": "node --import ../coding-agent/src/experimental/source-resolver.ts --test test/startup.test.ts test/scheduling.test.ts test/control.test.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@wechatbot/wechatbot": "2.2.0",
		"qrcode-terminal": "0.12.0",
		"proper-lockfile": "4.1.2",
		"silk-wasm": "3.7.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.3.4"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
